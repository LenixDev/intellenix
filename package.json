	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"format": "pnpm exec prettier . --write",
		"lint": "pnpm exec eslint . --fix",
		"build": "npx expo export --platform web",
		"ip": "ipconfig getifaddr en0",

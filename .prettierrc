{
	"experimentalTernaries": true,
	"experimentalOperatorPosition": "start",
	"tabWidth": 2,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"arrowParens": "avoid",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"objectWrap": "collapse",
	"trailingComma": "none",
	"singleAttributePerLine": false
}
